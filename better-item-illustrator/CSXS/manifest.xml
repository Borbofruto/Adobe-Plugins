<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.borbofruto.betteritem.illustrator" ExtensionBundleVersion="0.4.0"
                   ExtensionBundleName="Better Item" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.borbofruto.betteritem.illustrator.panel" Version="0.4.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- Illustrator 2022 (26) em diante -->
      <Host Name="ILST" Version="[26.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.borbofruto.betteritem.illustrator.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Better Item</Menu>
          <Geometry>
            <Size><Height>720</Height><Width>300</Width></Size>
            <MinSize><Height>300</Height><Width>240</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
